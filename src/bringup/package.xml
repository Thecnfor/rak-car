<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>rak assembly — launch files, URDF, calibration params, DDS config</description>
  <maintainer email="thecnfor@users.noreply.github.com">Thecnfor</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- bringup composes these packages at launch time -->
  <exec_depend>hardware</exec_depend>
  <exec_depend>cognition</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
